[Unit]
Description=Agente ADB Caller SaaS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adbcaller
Group=adbcaller
ExecStart=/opt/adbcaller-agent/adbcaller-agent run --config /var/lib/adbcaller-agent/config.json
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/adbcaller-agent

[Install]
WantedBy=multi-user.target
